{
  "name": "allaspectsbarn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "check:quick": "npm run validate:content && npm run typecheck && npm run lint",
    "check": "npm run format:check && npm run check:quick",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,json,md}": [
      "prettier --write --list-different"
    ]
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "flexsearch": "^0.8.212",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "next": "^15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
